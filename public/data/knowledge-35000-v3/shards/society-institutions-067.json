cb","prompt":"哪个术语指“主要沿父亲一方追溯群体成员身份和继嗣关系的制度”？","categoryId":"society-institutions","tagIds":["subfield:anthropology","object:concept"],"options":[{"optionId":"question-faefeb85a03373cb-a","text":"父系继嗣"},{"optionId":"question-faefeb85a03373cb-b","text":"母系继嗣"},{"optionId":"question-faefeb85a03373cb-c","text":"双系继嗣"},{"optionId":"question-faefeb85a03373cb-d","text":"非单系继嗣"}],"correctOptionId":"question-faefeb85a03373cb-a"},{"questionId":"question-fbdd4a36cadf98ce","prompt":"哪个术语指“国家依法剥夺生命、自由或财产时应遵守公平程序的原则”？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept","topic:human-rights"],"options":[{"optionId":"question-fbdd4a36cadf98ce-a","text":"正当程序"},{"optionId":"question-fbdd4a36cadf98ce-b","text":"严格责任"},{"optionId":"question-fbdd4a36cadf98ce-c","text":"国家豁免"},{"optionId":"question-fbdd4a36cadf98ce-d","text":"契约自由"}],"correctOptionId":"question-fbdd4a36cadf98ce-a"},{"questionId":"question-fda94483fade8b15","prompt":"哪个术语指“学生通过学校制度和日常互动非正式学到的规范与价值观”？","categoryId":"society-institutions","tagIds":["subfield:education","object:concept","topic:education"],"options":[{"optionId":"question-fda94483fade8b15-a","text":"隐性课程"},{"optionId":"question-fda94483fade8b15-b","text":"正式课程"},{"optionId":"question-fda94483fade8b15-c","text":"核心课程"},{"optionId":"question-fda94483fade8b15-d","text":"选修课程"}],"correctOptionId":"question-fda94483fade8b15-a"},{"questionId":"question-fea7dbc79807d32c","prompt":"哪个术语指“由一个自然人拥有并经营的非法人企业形式”？","categoryId":"society-institutions","tagIds":["subfield:business","object:concept"],"options":[{"optionId":"question-fea7dbc79807d32c-a","text":"个人独资企业"},{"optionId":"question-fea7dbc79807d32c-b","text":"合伙企业"},{"optionId":"question-fea7dbc79807d32c-c","text":"股份公司"},{"optionId":"question-fea7dbc79807d32c-d","text":"合作社"}],"correctOptionId":"question-fea7dbc79807d32c-a"},{"questionId":"question-ffc3fe92abb99e46","prompt":"哪个术语指“生产主要用于家庭或社群直接消费而非市场销售的经济方式”？","categoryId":"society-institutions","tagIds":["subfield:anthropology","object:concept"],"options":[{"optionId":"question-ffc3fe92abb99e46-a","text":"生计经济"},{"optionId":"question-ffc3fe92abb99e46-b","text":"出口经济"},{"optionId":"question-ffc3fe92abb99e46-c","text":"金融经济"},{"optionId":"question-ffc3fe92abb99e46-d","text":"平台经济"}],"correctOptionId":"question-ffc3fe92abb99e46-a"},{"questionId":"question-ffe42b116f48ef05","prompt":"哪个术语指“份额在证券交易所连续挂牌交易的开放式投资基金”？","categoryId":"society-institutions","tagIds":["subfield:finance","object:concept"],"options":[{"optionId":"question-ffe42b116f48ef05-a","text":"交易所交易基金"},{"optionId":"question-ffe42b116f48ef05-b","text":"普通开放式基金"},{"optionId":"question-ffe42b116f48ef05-c","text":"对冲基金"},{"optionId":"question-ffe42b116f48ef05-d","text":"私募股权基金"}],"correctOptionId":"question-ffe42b116f48ef05-a"},{"questionId":"question-fffcc7be888deca2","prompt":"哪个术语指“借款人不能按约定支付利息或本金的可能性”？","categoryId":"society-institutions","tagIds":["subfield:finance","object:concept"],"options":[{"optionId":"question-fffcc7be888deca2-a","text":"违约风险"},{"optionId":"question-fffcc7be888deca2-b","text":"市场风险"},{"optionId":"question-fffcc7be888deca2-c","text":"操作风险"},{"optionId":"question-fffcc7be888deca2-d","text":"汇率风险"}],"correctOptionId":"question-fffcc7be888deca2-a"},{"questionId":"q35v2-si-0001","prompt":"买卖双方的私有估值独立地来自相互重叠的分布。若机制还须使如实报告成为均衡、自愿参与且不靠外部补贴，哪项经典结果限制了实现每次有效成交？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0001-a","text":"收入等价定理"},{"optionId":"q35v2-si-0001-b","text":"迈尔森—萨特思韦特定理"},{"optionId":"q35v2-si-0001-c","text":"科斯定理"},{"optionId":"q35v2-si-0001-d","text":"阿罗不可能定理"}],"correctOptionId":"q35v2-si-0001-b"},{"questionId":"q35v2-si-0002","prompt":"某经济中一项垄断扭曲暂时无法消除。按照福利经济学的相关结论，此时把其他市场逐一恢复到无扭曲状态是否必然提高福利？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0002-a","text":"必然；每消除一项扭曲都会提高福利"},{"optionId":"q35v2-si-0002-b","text":"不必然；保留或引入另一项偏离有时反而更接近可行最优"},{"optionId":"q35v2-si-0002-c","text":"只有把所有商品改为统一价格才会提高福利"},{"optionId":"q35v2-si-0002-d","text":"只要政府不征税，其他扭曲就无关紧要"}],"correctOptionId":"q35v2-si-0002-b"},{"questionId":"q35v2-si-0003","prompt":"两种金属铸币依法按同一面值流通，但其中一种所含金属的市场价值更高。在兑换和持有均较自由时，最可能出现哪种结果？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0003-a","text":"两种铸币始终按相同数量平均流通"},{"optionId":"q35v2-si-0003-b","text":"低内在价值铸币被收藏，高内在价值铸币留在流通中"},{"optionId":"q35v2-si-0003-c","text":"高内在价值铸币被收藏或输出，低内在价值铸币更多留在流通中"},{"optionId":"q35v2-si-0003-d","text":"两种铸币都会立即失去法偿地位"}],"correctOptionId":"q35v2-si-0003-c"},{"questionId":"q35v2-si-0004","prompt":"两国生产率和市场条件相近，一国大幅收紧排放标准后，高排放行业的新投资更多转向监管较宽松的另一国。哪项假说预测这种区位反应？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0004-a","text":"波特假说"},{"optionId":"q35v2-si-0004-b","text":"环境库兹涅茨曲线"},{"optionId":"q35v2-si-0004-c","text":"双重红利假说"},{"optionId":"q35v2-si-0004-d","text":"污染避难所假说"}],"correctOptionId":"q35v2-si-0004-d"},{"questionId":"q35v2-si-0005","prompt":"在竞争、确定性且开采成本可忽略的简化条件下，不可再生资源所有者在“现在开采”和“留待以后”之间无差异时，地下资源租金通常应如何变化？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0005-a","text":"按市场利率随时间增长"},{"optionId":"q35v2-si-0005-b","text":"每期按固定数量下降"},{"optionId":"q35v2-si-0005-c","text":"始终等于零"},{"optionId":"q35v2-si-0005-d","text":"只随当期工资率变化"}],"correctOptionId":"q35v2-si-0005-a"},{"questionId":"q35v2-si-0006","prompt":"某税种的税率已很高，进一步提高税率后，税基收缩和规避增加，税收收入反而下降。这一可能性最符合哪种关系？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0006-a","text":"税率与税收收入在任何范围内都严格成正比"},{"optionId":"q35v2-si-0006-b","text":"税率与税收收入之间可能存在倒U形关系"},{"optionId":"q35v2-si-0006-c","text":"税率只影响物价而不影响税基"},{"optionId":"q35v2-si-0006-d","text":"税率越高，边际税收收入必然越大"}],"correctOptionId":"q35v2-si-0006-b"},{"questionId":"q35v2-si-0007","prompt":"在两国两产品两要素模型中，商品价格不变而一国资本禀赋增加。若一项产品资本密集，经典贸易理论预期该国产出结构怎样调整？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept","topic:trade"],"options":[{"optionId":"q35v2-si-0007-a","text":"两种产品产出必定同比例增加"},{"optionId":"q35v2-si-0007-b","text":"劳动密集品产出增幅较大，资本密集品产出收缩"},{"optionId":"q35v2-si-0007-c","text":"资本密集品产出增幅较大，劳动密集品产出收缩"},{"optionId":"q35v2-si-0007-d","text":"产品结构不受要素禀赋影响"}],"correctOptionId":"q35v2-si-0007-c"},{"questionId":"q35v2-si-0008","prompt":"某大国提高进口关税后，外国出口商降价幅度超过税负，结果该进口品的国内含税价格反而下降。这一理论上可能出现的结果称什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept","topic:trade"],"options":[{"optionId":"q35v2-si-0008-a","text":"贫困化增长效应"},{"optionId":"q35v2-si-0008-b","text":"斯托尔珀—萨缪尔森定理"},{"optionId":"q35v2-si-0008-c","text":"梅茨勒悖论"},{"optionId":"q35v2-si-0008-d","text":"勒纳对称定理"}],"correctOptionId":"q35v2-si-0008-c"},{"questionId":"q35v2-si-0009","prompt":"在贸易平衡且价格可调整的标准两国模型中，一国想实现与对所有进口统一征税相同的相对价格效果，但改用出口端工具。按勒纳对称定理，应采用哪项措施？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0009-a","text":"对所有出口按同一税率补贴"},{"optionId":"q35v2-si-0009-b","text":"对所有进口按同一税率补贴"},{"optionId":"q35v2-si-0009-c","text":"对国内生产统一补贴"},{"optionId":"q35v2-si-0009-d","text":"对所有出口按同一税率征税"}],"correctOptionId":"q35v2-si-0009-d"},{"questionId":"q35v2-si-0010","prompt":"在布雷顿森林体系下，世界需要美国持续提供美元储备资产；但美元负债越多，市场越怀疑其按固定价格兑换黄金的能力。这一制度性张力称什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0010-a","text":"蒙代尔不可能三角"},{"optionId":"q35v2-si-0010-b","text":"特里芬难题"},{"optionId":"q35v2-si-0010-c","text":"卢卡斯批判"},{"optionId":"q35v2-si-0010-d","text":"荷兰病"}],"correctOptionId":"q35v2-si-0010-b"},{"questionId":"q35v2-si-0011","prompt":"一次严重衰退使部分劳动者长期失去技能和就业联系；即使总需求恢复，失业率仍停留在更高水平。哪种机制最能解释这一持续影响？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0011-a","text":"摩擦性失业会在招聘增加时永久为零"},{"optionId":"q35v2-si-0011-b","text":"劳动参与率与历史经历完全无关"},{"optionId":"q35v2-si-0011-c","text":"暂时冲击可能改变此后的均衡失业路径"},{"optionId":"q35v2-si-0011-d","text":"工资下降必然立即恢复全部就业"}],"correctOptionId":"q35v2-si-0011-c"},{"questionId":"q35v2-si-0012","prompt":"一家餐馆知道需求略有下降，却因重新印菜单、更新系统和通知顾客需要付出小额成本而暂不调价。这个例子说明什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0012-a","text":"价格调整没有任何资源成本"},{"optionId":"q35v2-si-0012-b","text":"需求变化只会改变长期资本存量"},{"optionId":"q35v2-si-0012-c","text":"企业必须每天重新制定所有价格"},{"optionId":"q35v2-si-0012-d","text":"微小改价成本也可能造成名义价格黏性"}],"correctOptionId":"q35v2-si-0012-d"},{"questionId":"q35v2-si-0013","prompt":"消费者的最小支出函数 e(p,u) 可微。在效用水平 u 固定时，对第 i 种商品价格求偏导，谢泼德引理给出什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0013-a","text":"第 i 种商品的马歇尔需求量"},{"optionId":"q35v2-si-0013-b","text":"第 i 种商品的希克斯需求量"},{"optionId":"q35v2-si-0013-c","text":"第 i 种商品的补偿价格弹性"},{"optionId":"q35v2-si-0013-d","text":"达到 u 时的预算约束乘子"}],"correctOptionId":"q35v2-si-0013-b"},{"questionId":"q35v2-si-0014","prompt":"在标准戴蒙德—米尔利斯最优税框架中，生产效率定理对生产环节的含义是什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0014-a","text":"按行业设置不同的投入税以改变企业技术选择"},{"optionId":"q35v2-si-0014-b","text":"在每个生产阶段重复征收毛额流转税"},{"optionId":"q35v2-si-0014-c","text":"按企业资本密集度设置差别产出税"},{"optionId":"q35v2-si-0014-d","text":"避免在生产者之间形成税楔，主要在最终消费环节筹资"}],"correctOptionId":"q35v2-si-0014-d"},{"questionId":"q35v2-si-0015","prompt":"政府希望同时稳定通胀、汇率和就业，但只有两个彼此独立的政策工具。按照政策设计的一项经典原则，主要问题是什么？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0015-a","text":"只要目标数量较多，工具数量就不重要"},{"optionId":"q35v2-si-0015-b","text":"一个工具总能独立控制任意多个目标"},{"optionId":"q35v2-si-0015-c","text":"独立政策工具少于独立目标，难以同时精确实现全部目标"},{"optionId":"q35v2-si-0015-d","text":"政策工具越多，目标必然越不稳定"}],"correctOptionId":"q35v2-si-0015-c"},{"questionId":"q35v2-si-0016","prompt":"在某一纯公共品的当前数量附近，三人的边际支付意愿分别为2、3和1个货币单位，边际成本为5。其他条件不变，效率条件指向哪种调整？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0016-a","text":"边际增加供给"},{"optionId":"q35v2-si-0016-b","text":"边际减少供给"},{"optionId":"q35v2-si-0016-c","text":"保持当前数量不变"},{"optionId":"q35v2-si-0016-d","text":"仅凭这些数值无法判断"}],"correctOptionId":"q35v2-si-0016-a"},{"questionId":"q35v2-si-0017","prompt":"某经济只有甲、乙两种商品。甲的价格比为2、支出份额从0.4升至0.6；乙的价格比为1、支出份额从0.6降至0.4。按托恩奎斯特价格指数，以两期平均支出份额为权重计算价格比的几何平均，指数约为多少？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept","topic:measurement"],"options":[{"optionId":"q35v2-si-0017-a","text":"1.414"},{"optionId":"q35v2-si-0017-b","text":"1.400"},{"optionId":"q35v2-si-0017-c","text":"1.500"},{"optionId":"q35v2-si-0017-d","text":"2.000"}],"correctOptionId":"q35v2-si-0017-a"},{"questionId":"q35v2-si-0018","prompt":"计算同一收入分配的阿特金森指数时，把不平等厌恶参数调高，最直接改变了评价的哪一方面？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept","topic:measurement"],"options":[{"optionId":"q35v2-si-0018-a","text":"只比较最高与最低收入"},{"optionId":"q35v2-si-0018-b","text":"不再满足转移原则"},{"optionId":"q35v2-si-0018-c","text":"变为依赖货币计价单位"},{"optionId":"q35v2-si-0018-d","text":"更重视分布底部的收入差异"}],"correctOptionId":"q35v2-si-0018-d"},{"questionId":"q35v2-si-0019","prompt":"政府对污染征税，并把收入用于下调原有的劳动税。所谓“双重收益”主张指的是哪种可能结果？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept","topic:environment"],"options":[{"optionId":"q35v2-si-0019-a","text":"污染下降必然同时使全部税收收入归零"},{"optionId":"q35v2-si-0019-b","text":"任何环境税都会在不改变行为时提高福利"},{"optionId":"q35v2-si-0019-c","text":"既减少环境损害，又因税收替代降低原有税制扭曲"},{"optionId":"q35v2-si-0019-d","text":"只要返还收入，污染排放就必然增加"}],"correctOptionId":"q35v2-si-0019-c"},{"questionId":"q35v2-si-0020","prompt":"政府需以商品税筹集既定收入，假定消费者相同、商品间无交叉价格效应且不考虑分配目标。为使超额负担尽量小，税率结构应倾向于哪一种？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0020-a","text":"对补偿需求反应较小的商品征较高税率"},{"optionId":"q35v2-si-0020-b","text":"对所有商品采用相同从价税率"},{"optionId":"q35v2-si-0020-c","text":"对需求反应更敏感的商品征较高税率"},{"optionId":"q35v2-si-0020-d","text":"仅按商品生产成本高低设定税率"}],"correctOptionId":"q35v2-si-0020-a"},{"questionId":"q35v2-si-0021","prompt":"在共同价值拍卖中，竞买者对标的真实价值各自获得有噪声估计。为什么最高出价者即使诚实估计也容易买贵？","categoryId":"society-institutions","tagIds":["subfield:economics","object:concept"],"options":[{"optionId":"q35v2-si-0021-a","text":"中标本身意味着其估计很可能是样本中最乐观的一个"},{"optionId":"q35v2-si-0021-b","text":"最高出价者必然掌握最准确的信息"},{"optionId":"q35v2-si-0021-c","text":"共同价值标的不存在估计误差"},{"optionId":"q35v2-si-0021-d","text":"第二高报价必然高于标的真实价值"}],"correctOptionId":"q35v2-si-0021-a"},{"questionId":"q35v2-si-0022","prompt":"在美国《统一商法典》第2编下，假定是单次交付，且不涉及卖方补救期限。依完全交付规则（perfect tender rule），货物有任何不符合合同约定之处时，买方原则上有哪组选择？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0022-a","text":"只能接受全部货物，再另行请求损害赔偿"},{"optionId":"q35v2-si-0022-b","text":"只能拒收全部货物，不能保留任何部分"},{"optionId":"q35v2-si-0022-c","text":"合同自动撤销，买方无须作出接受或拒收决定"},{"optionId":"q35v2-si-0022-d","text":"可拒收全部、接受全部，或接受部分商业单位并拒收其余部分"}],"correctOptionId":"q35v2-si-0022-d"},{"questionId":"q35v2-si-0023","prompt":"在美国民事诉讼中，外州企业主动持续向该州销售并从中获利。法院判断能否对其行使属人管辖时，正当程序首先关注什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0023-a","text":"原告是否拥有该州不动产"},{"optionId":"q35v2-si-0023-b","text":"陪审员是否全部来自被告所在州"},{"optionId":"q35v2-si-0023-c","text":"被告是否与该州形成有目的且足以预见被诉的联系"},{"optionId":"q35v2-si-0023-d","text":"争议金额是否恰好等于联邦最低工资"}],"correctOptionId":"q35v2-si-0023-c"},{"questionId":"q35v2-si-0024","prompt":"根据《美国联邦证据规则》第407条，事后补救措施通常不得用于证明过失。若相关事项确有争议，该证据可用于证明哪一项？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0024-a","text":"行为人在事故发生时有过失"},{"optionId":"q35v2-si-0024-b","text":"行为人实施了应受责难的行为"},{"optionId":"q35v2-si-0024-c","text":"产品设计在事故发生时存在缺陷"},{"optionId":"q35v2-si-0024-d","text":"有关物品的所有权或控制权"}],"correctOptionId":"q35v2-si-0024-d"},{"questionId":"q35v2-si-0025","prompt":"被告对原告拥有一项源自同一交易的请求，却未在现有诉讼中提出。某些普通法程序下，这项请求以后可能被阻却，原因是什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0025-a","text":"它属于通常应在本案提出的强制反诉"},{"optionId":"q35v2-si-0025-b","text":"它属于只能由检察官提出的刑事指控"},{"optionId":"q35v2-si-0025-c","text":"它属于法院不得受理的政治问题"},{"optionId":"q35v2-si-0025-d","text":"它属于无需送达即可生效的禁令"}],"correctOptionId":"q35v2-si-0025-a"},{"questionId":"q35v2-si-0026","prompt":"美国联邦法院仅因当事人州籍不同审理州法请求，且没有适用的联邦成文法或联邦诉讼规则。法院原则上应适用州实体法。该要求源于哪项原则？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0026-a","text":"伊利原则（Erie doctrine）"},{"optionId":"q35v2-si-0026-b","text":"扬格回避原则"},{"optionId":"q35v2-si-0026-c","text":"国家行为原则"},{"optionId":"q35v2-si-0026-d","text":"政治问题原则"}],"correctOptionId":"q35v2-si-0026-a"},{"questionId":"q35v2-si-0027","prompt":"美国警员依一份表面有效的搜查令取证，之后法院认定令状依据不足；警员无从知晓该瑕疵且执行方式客观合理。证据通常可依据哪项例外不被排除？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0027-a","text":"独立来源例外"},{"optionId":"q35v2-si-0027-b","text":"必然发现例外"},{"optionId":"q35v2-si-0027-c","text":"善意例外"},{"optionId":"q35v2-si-0027-d","text":"衰减联系例外"}],"correctOptionId":"q35v2-si-0027-c"},{"questionId":"q35v2-si-0028","prompt":"一项民事请求直接依据美国联邦宪法或联邦制定法提出。即使双方并非不同州居民，联邦法院可能基于什么受理？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0028-a","text":"当事人可用合同任意扩大法院事项权限"},{"optionId":"q35v2-si-0028-b","text":"任何金额的州法纠纷都自动进入联邦法院"},{"optionId":"q35v2-si-0028-c","text":"只要被告提出反诉就必然产生海事管辖"},{"optionId":"q35v2-si-0028-d","text":"请求本身产生于联邦法的事项管辖依据"}],"correctOptionId":"q35v2-si-0028-d"},{"questionId":"q35v2-si-0029","prompt":"在普通法慈善信托中，指定用途后来无法实施，但证据表明设立人具有一般慈善意图。法院最典型的处理是什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0029-a","text":"设立结果信托，将财产返还设立人或其遗产"},{"optionId":"q35v2-si-0029-b","text":"仅修改受托人的管理权限，不改变已无法完成的用途"},{"optionId":"q35v2-si-0029-c","text":"终止信托，并按现有受益机构的资产规模分配财产"},{"optionId":"q35v2-si-0029-d","text":"将财产用于尽可能接近原意的可行公益目的"}],"correctOptionId":"q35v2-si-0029-d"},{"questionId":"q35v2-si-0030","prompt":"陪审团在补偿受害者实际损失之外，又因被告恶意且鲁莽的行为判给额外金额。该额外金额的主要法律目的是什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0030-a","text":"精确恢复受害者损失前财产状态"},{"optionId":"q35v2-si-0030-b","text":"惩戒特别恶劣行为并形成威慑"},{"optionId":"q35v2-si-0030-c","text":"返还被告从合同取得的全部利益"},{"optionId":"q35v2-si-0030-d","text":"支付法院日常行政费用"}],"correctOptionId":"q35v2-si-0030-b"},{"questionId":"q35v2-si-0031","prompt":"成年观众明知棒球可能飞入看台，仍自愿坐在未设防护网的区域；受伤后，被告主张其已自愿接受该项固有危险。该抗辩强调什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0031-a","text":"任何受伤者都自动放弃诉权"},{"optionId":"q35v2-si-0031-b","text":"被告只要购买保险就不承担责任"},{"optionId":"q35v2-si-0031-c","text":"原告在知情且自愿的情况下选择面对特定风险"},{"optionId":"q35v2-si-0031-d","text":"危险活动从不产生注意义务"}],"correctOptionId":"q35v2-si-0031-c"},{"questionId":"q35v2-si-0032","prompt":"在美国传统普通法地产制度中，“转让给学校，只要土地用于教学”与“转让给学校，但若停止教学，转让人可以收回”的典型区别是什么？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0032-a","text":"前者在条件违反时自动终止，后者须由转让人行使终止权"},{"optionId":"q35v2-si-0032-b","text":"前者须由转让人行使终止权，后者在条件违反时自动终止"},{"optionId":"q35v2-si-0032-c","text":"两者在条件违反时都自动终止"},{"optionId":"q35v2-si-0032-d","text":"两者都只产生损害赔偿，不影响地产权"}],"correctOptionId":"q35v2-si-0032-a"},{"questionId":"q35v2-si-0033","prompt":"美国一名公职人员就涉及公共事务的失实报道提起诽谤诉讼。除证明陈述虚假外，通常还须证明媒体具有哪种主观状态？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0033-a","text":"明知虚假，或对真伪采取鲁莽漠视"},{"optionId":"q35v2-si-0033-b","text":"仅仅没有使用匿名消息来源"},{"optionId":"q35v2-si-0033-c","text":"对公职人员持一般批评态度"},{"optionId":"q35v2-si-0033-d","text":"未在报道前取得政府许可"}],"correctOptionId":"q35v2-si-0033-a"},{"questionId":"q35v2-si-0034","prompt":"某人秘密在他人卧室安装摄像头，但尚未公开录像。即使没有向第三人传播内容，最直接涉及哪类隐私侵权？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept"],"options":[{"optionId":"q35v2-si-0034-a","text":"使用他人商标造成来源混淆"},{"optionId":"q35v2-si-0034-b","text":"以高度冒犯方式侵入他人合理期待私密的空间"},{"optionId":"q35v2-si-0034-c","text":"公开真实但无关紧要的政府预算"},{"optionId":"q35v2-si-0034-d","text":"拒绝履行买卖合同"}],"correctOptionId":"q35v2-si-0034-b"},{"questionId":"q35v2-si-0035","prompt":"美国警员依据具体、可说明的事实，短暂拦停一人调查并在合理担心其携带武器时进行有限拍查。这种拦停通常要求达到哪一较低门槛？","categoryId":"society-institutions","tagIds":["subfield:law","object:concept","topic:human-rights"],"options":[{"optionId":"q35v2-si-0035-a","text":"排除合理怀疑"},{"optionId":"q35v2-si-0035-b","text":"优势证据"},{"optionId":"q35v2-si-0035-c","text":"合理怀疑"},{"optionId":"q35v2-si-0035-d","text":"严格审查"}],"correctOptionId":"q35v2-si-0035-c"}]}